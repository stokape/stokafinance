# ─────────────────────────────────────────────────────────────────────────
# STOKA Finance — Variables de entorno
# Copiar a .env.local (nunca commitear .env.local — ver .gitignore)
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUERIDO) ────────────────────────────────────────────────
# Free tier: https://supabase.com — crear proyecto, copiar de Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo se usa server-side (backups, tareas admin). NUNCA exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App (REQUERIDO) ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=PEN
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Lima
NEXT_PUBLIC_DEFAULT_LOCALE=es-PE

# ── Modo mantenimiento (OPCIONAL, zero-cost) ─────────────────────────────
# En `true`, src/proxy.ts devuelve una página de mantenimiento (503) para
# TODA la app, sin tocar código ni hacer un deploy nuevo — solo cambiar
# esta variable en Vercel y esperar a que aplique.
MAINTENANCE_MODE=false
# Token secreto para saltarte el mantenimiento mientras pruebas
# (?stoka_bypass=<este-valor> en cualquier URL, una vez queda en cookie 1
# día). Vacío = nadie puede saltárselo, ni siquiera tú. Generar con:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MAINTENANCE_BYPASS_TOKEN=

# ── Notificaciones push (OPCIONAL, zero-cost — Web Push/VAPID) ───────────
# Sin estas 3 variables, el botón "Activar notificaciones" de Configuración
# falla con un aviso claro; el resto de la app funciona igual. Generar con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: de contacto — lo exige el protocolo VAPID para que el servicio
# push (FCM, etc.) pueda contactar al emisor si algo va mal.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Token para que el cron diario (vercel.json) se autentique al llamar a
# /api/cron/notify-upcoming — Vercel lo manda como
# "Authorization: Bearer <este-valor>" automáticamente si está configurado
# como CRON_SECRET en el proyecto de Vercel. Generar con:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=

# ── Cifrado de backups (REQUERIDO sólo si se usa el módulo de Backups) ───
# Clave simétrica de 32 bytes en base64 para AES-256-GCM. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guardar fuera del repo (Vercel env vars). Sin esta clave no se pueden
# restaurar los backups existentes: tratarla como secreto crítico.
BACKUP_ENCRYPTION_KEY=

# ── Feature flags — TODO deshabilitado por defecto (costo US$0) ─────────
# Ver docs/costs.md y docs/whatsapp.md antes de activar cualquiera de estos.
WHATSAPP_ENABLED=false
AI_ENABLED=false
OCR_ENABLED=false
BANK_SYNC_ENABLED=false

# ── FUTURO / OPCIONAL — no requeridas mientras los flags de arriba sean false
# Monitoreo de errores (Sentry, free tier disponible). La app arranca y
# funciona igual sin esto — sin DSN, el SDK no se inicializa y no hace
# ninguna llamada de red (ver src/lib/monitoring/sentry.ts).
# SENTRY_DSN = server + edge. NEXT_PUBLIC_SENTRY_DSN = navegador (puede
# ser el mismo valor en ambas).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# IA (financial-copilot) — sólo si AI_ENABLED=true
OPENAI_API_KEY=

# Email transaccional (recuperación de contraseña usa Supabase Auth por
# defecto y no requiere esto; sólo si se reemplaza el proveedor de email)
RESEND_API_KEY=

# WhatsApp Business Cloud API — NO configurar mientras WHATSAPP_ENABLED=false.
# Activar requiere aprobación explícita (ver docs/whatsapp.md §Cost Control).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Drive backup (OAuth 2.0) — requerido sólo para activar backups a Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
